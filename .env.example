# Mimanasa Mobile App - Environment Variables Template
# Copy this file to .env and fill in your values

# ============================================
# API Configuration (Required)
# ============================================
# Backend API base URL - must end with /api
API_BASE_URL=https://mimamsabackend.onrender.com/api

# Environment: development | staging | production
ENV=production

# ============================================
# Cloudinary Configuration (Required for uploads)
# ============================================
# Get these from your Cloudinary Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# ============================================
# EAS Build Configuration (Optional)
# ============================================
# EAS Project ID from expo.dev
# EAS_PROJECT_ID=your_eas_project_id
